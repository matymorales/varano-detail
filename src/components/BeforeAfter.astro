---
import { beforeAfter } from "../data/site";
---

<section class="relative overflow-hidden py-24 sm:py-32">
  <div class="wrap">
    <div class="mb-12 text-center md:mb-16" data-reveal>
      <p class="eyebrow mb-5 justify-center">Resultados</p>
      <h2 class="font-display font-black uppercase leading-[0.98] tracking-[-0.015em] text-white">
        <span class="text-4xl sm:text-5xl md:text-6xl">Antes</span>
        <span class="mx-3 inline-block h-2.5 w-2.5 translate-y-[-4px] rotate-45 bg-racing-orange sm:mx-5 sm:translate-y-[-6px]" />
        <span class="text-racing-orange text-4xl sm:text-5xl md:text-6xl">Después</span>
      </h2>

      <p class="mx-auto mt-6 max-w-xl text-sm leading-relaxed text-white/55">
        Mové el control para comparar el antes y el después. Pulido, sellado y corrección
        hechos a mano. Apretá <kbd class="rounded-md border border-white/15 px-1.5 py-0.5 text-[10px] text-white/60">←</kbd>
        <kbd class="ml-1 rounded-md border border-white/15 px-1.5 py-0.5 text-[10px] text-white/60">→</kbd> en el teclado.
      </p>
    </div>

    <div
      data-ba
      tabindex="0"
      aria-label="Comparador antes y después. Usa las flechas del teclado para deslizar."
      class="group relative mx-auto aspect-[16/10] max-w-3xl cursor-ew-resize touch-none overflow-hidden rounded-xl border border-white/10 shadow-[0_40px_120px_-48px_rgba(0,0,0,0.9)] select-none outline-none focus-visible:border-racing-orange"
      style="--pos: 50%"
      data-reveal
    >
      {/* After (base layer) */}
      <img
        src={beforeAfter.after.src}
        alt="Auto después del detailing"
        class="absolute inset-0 h-full w-full object-cover object-center"
        fetchpriority="high"
        decoding="async"
        draggable="false"
      />

      {/* Before (clipped layer) */}
      <div data-ba-clip class="absolute inset-0" style="clip-path: inset(0 calc(100% - var(--pos)) 0 0)">
        <img
          src={beforeAfter.before.src}
          alt="Auto antes del detailing"
          class="absolute inset-0 h-full w-full object-cover object-center"
          loading="lazy"
          decoding="async"
          draggable="false"
        />
        <div class="absolute inset-0 bg-carbon-950/25" aria-hidden="true" />

        <span
          data-ba-label
          data-ba-layer="before"
          class="absolute bottom-4 left-4 z-10 rounded-md bg-carbon-950/85 px-3 py-1.5 text-[11px] font-extrabold uppercase tracking-[0.22em] text-white/90 backdrop-blur"
        >
          Antes
        </span>
      </div>

      {/* After label */}
      <span class="absolute right-4 bottom-4 z-10 rounded-md bg-racing-orange px-3 py-1.5 text-[11px] font-extrabold uppercase tracking-[0.22em] text-black">
        Después
      </span>

      {/* Divider + handle */}
      <div class="absolute inset-y-0 z-20" style="left: var(--pos)">
        <div class="absolute inset-y-0 -left-px w-px bg-white/80" />
        <div class="absolute top-1/2 -translate-x-1/2 -translate-y-1/2">
          <div class="flex h-12 w-12 items-center justify-center rounded-full border border-white/70 bg-carbon-900/85 text-white shadow-[0_8px_32px_-10px_rgba(255,106,0,0.55)] backdrop-blur transition-transform duration-300 group-[.is-dragging]:scale-105">
            <span class="text-lg text-racing-orange">‹</span>
            <span class="mx-0.5 h-4 w-px bg-white/40" />
            <span class="text-lg text-racing-orange">›</span>
          </div>
        </div>
      </div>

      {/* Accessibility range input */}
      <input
        data-ba-input
        type="range"
        min="0"
        max="100"
        value="50"
        aria-label="Posición del comparador"
        class="pointer-events-none absolute inset-0 h-full w-full cursor-ew-resize opacity-0"
      />
    </div>
  </div>
</section>