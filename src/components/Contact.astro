---
import Icon from "./ui/Icon.astro";
import { contact, paymentMethods, whatsapp } from "../data/site";
---

  <section class="relative overflow-hidden bg-carbon-950 py-24 sm:py-32">
  <div class="absolute inset-0 bg-[radial-gradient(720px_420px_at_50%_0%,rgba(255,106,0,0.06),transparent_70%)]" aria-hidden="true" />

  <div id="contacto" class="wrap relative">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="eyebrow mb-6 justify-center">Contacto</p>
      <h2 class="font-display font-black uppercase leading-[0.98] tracking-[-0.015em] text-white">
        <span class="block text-4xl sm:text-6xl md:text-7xl">¿Listo para un</span>
        <span class="block text-racing-orange text-4xl sm:text-6xl md:text-7xl">
          cambio real?
        </span>
      </h2>
      <p class="mx-auto mt-7 max-w-xl text-base leading-relaxed text-white/60 sm:text-lg">
        Consultá por tu vehículo, pedí presupuesto o reservá tu turno. Respondemos rápido
        y coordinamos el trabajo más cómodo para vos.
      </p>

      <a
        href={whatsapp.link + encodeURIComponent(whatsapp.text)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary mx-auto mt-10 !px-10 !py-5 text-base"
      >
        <Icon name="whatsapp" className="h-6 w-6" />
        Consultar por WhatsApp
      </a>
    </div>

    <div class="mx-auto mt-16 grid max-w-4xl gap-5 sm:grid-cols-3" data-reveal style="--reveal-delay:140ms">
      <div class="tile flex flex-col items-start gap-3 p-6 sm:flex-row sm:items-center">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md border border-white/10 bg-white/[0.04] text-white/80">
          <Icon name="mapPin" className="h-5 w-5" />
        </span>
        <div>
          <p class="text-[10px] font-extrabold uppercase tracking-[0.22em] text-white/40">Zona</p>
          <p class="mt-0.5 text-sm font-bold text-white">{contact.zone}</p>
        </div>
      </div>

      <div class="tile flex flex-col items-start gap-3 p-6 sm:flex-row sm:items-center">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md border border-white/10 bg-white/[0.04] text-white/80">
          <Icon name="clock" className="h-5 w-5" />
        </span>
        <div>
          <p class="text-[10px] font-extrabold uppercase tracking-[0.22em] text-white/40">Horarios</p>
          <p class="mt-0.5 text-sm font-bold text-white">{contact.schedule}</p>
        </div>
      </div>

      <a
        href={contact.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="tile group flex flex-col items-start gap-3 p-6 hover:border-racing-orange/40 sm:flex-row sm:items-center"
      >
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md border border-white/10 bg-white/[0.04] text-white/80 transition-colors duration-300 group-hover:border-racing-orange/40 group-hover:text-racing-orange">
          <Icon name="instagram" className="h-5 w-5" />
        </span>
        <div>
          <p class="text-[10px] font-extrabold uppercase tracking-[0.22em] text-white/40">Instagram</p>
          <p class="mt-0.5 text-sm font-bold text-white group-hover:text-racing-orange">{contact.instagram.handle}</p>
        </div>
      </a>
    </div>

    {/* Payment methods — tile matching info tiles */}
    <div class="mx-auto mt-5 max-w-4xl" data-reveal style="--reveal-delay:220ms">
      <div class="tile flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md border border-white/10 bg-white/[0.04] text-white/80">
            <Icon name="cash" className="h-5 w-5" />
          </span>
          <div>
            <p class="text-[10px] font-extrabold uppercase tracking-[0.22em] text-white/40">Medios de pago</p>
            <p class="mt-0.5 text-sm font-bold text-white">
              {paymentMethods.map((m, i) => (
                <span>
                  {i > 0 && <span class="mx-2 text-white/25">·</span>}
                  {m.name}
                </span>
              ))}
            </p>
          </div>
        </div>
        <p class="flex items-center gap-1.5 text-xs text-white/45">
          <Icon name="shield" className="h-3.5 w-3.5 text-racing-orange" />
          Podés abonar al finalizar el trabajo. Sin adelantos.
        </p>
      </div>
    </div>
  </div>
</section>