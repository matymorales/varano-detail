---
import Icon from "./ui/Icon.astro";
import { gallery, galleryCategories } from "../data/site";
---

<section class="relative overflow-hidden bg-carbon-900 py-24 sm:py-32">
  <div id="trabajos" class="wrap relative">
    <div class="mb-8 flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal>
      <div>
        <p class="eyebrow mb-5">Trabajos recientes</p>
        <h2 class="font-display font-black uppercase leading-[0.98] tracking-[-0.015em] text-white">
          <span class="block text-4xl sm:text-5xl md:text-6xl">Galería</span>
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-white/55">
        Autos reales, resultados reales. Cada vehículo que pasa por el detail sale distinto en
        <strong class="text-white"> VARANO DETAIL</strong>.
      </p>
    </div>

    <div class="mb-8 flex flex-wrap items-center gap-2" data-gallery-filters data-reveal style="--reveal-delay:100ms">
      {galleryCategories.map((c) => (
        <button
          type="button"
          data-gallery-filter={c.key}
          class={`chip cursor-pointer transition-colors duration-300 [&.is-active]:border-racing-orange [&.is-active]:bg-racing-orange [&.is-active]:text-black ${c.key === "all" ? "is-active" : ""}`}
        >
          {c.label}
        </button>
      ))}
    </div>
  </div>

  <div class="wrap" data-reveal style="--reveal-delay:160ms">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {gallery.map((g, i) => (
        <figure
          data-category={g.category}
          class="group relative overflow-hidden rounded-xl border border-white/10 bg-carbon-800 transition-colors duration-300 hover:border-white/20"
        >
          <div class="relative aspect-[4/3] overflow-hidden">
            <img
              src={g.src}
              alt={g.caption}
              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading={i < 3 ? "eager" : "lazy"}
              decoding="async"
              draggable="false"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-carbon-950/90 via-carbon-950/20 to-transparent" />
          </div>
          <figcaption class="flex flex-col gap-1 p-4 sm:p-5">
            <span class="font-display text-lg font-extrabold uppercase tracking-tight text-white">
              {g.car}
            </span>
            <span class="text-xs font-bold uppercase tracking-[0.22em] text-racing-orange">
              {g.service}
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
