---
import Icon from "./ui/Icon.astro";
import { services, whatsapp } from "../data/site";

const featured = services.find((s) => s.featured);
const priceList = services.filter((s) => !s.featured);
---

<section class="section-glow relative py-24 sm:py-32">
  <div id="servicios" class="wrap">
    <div class="mb-14 flex flex-col gap-6 md:mb-16 md:flex-row md:items-end md:justify-between">
      <div data-reveal>
        <p class="eyebrow mb-5">Servicios</p>
        <h2 class="font-display font-black uppercase leading-[0.98] tracking-[-0.015em] text-white">
          <span class="block text-4xl sm:text-5xl md:text-6xl">Tratamiento</span>
          <span class="block text-outline text-4xl sm:text-5xl md:text-6xl">completo</span>
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-white/55" data-reveal style="--reveal-delay:100ms">
        Del lavado básico a la restauración profunda: cada servicio pensado para devolverle
        a tu vehículo esa terminación de estreno.
      </p>
    </div>

    {featured && (
      <a
        href={whatsapp.link + encodeURIComponent(`Hola VARANO DETAIL! Quiero consultar por el servicio de ${featured.title}.`)}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Consultar por WhatsApp: ${featured.title}`}
        class="tile group relative mb-12 block min-h-[340px] overflow-hidden sm:min-h-[420px]"
        data-reveal
      >
        <img
          src={featured.image}
          alt={featured.title}
          class="tile-media opacity-70"
          loading="eager"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-carbon-950 via-carbon-950/40 to-transparent" />
        <div class="relative flex h-full flex-col justify-end p-6 sm:p-8">
          <p class="mb-4 text-[10px] font-bold uppercase tracking-[0.28em] text-racing-orange/90">
            Consultar
          </p>
          <div class="flex items-end justify-between gap-4">
            <div>
              <h3 class="font-display text-3xl font-extrabold uppercase leading-[1.02] tracking-tight text-white sm:text-4xl">
                {featured.title}
              </h3>
              <p class="mt-3 max-w-lg text-sm leading-relaxed text-white/60">
                {featured.desc}
              </p>
            </div>
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-white/20 text-white/70 transition-all duration-300 group-hover:border-racing-orange group-hover:bg-racing-orange group-hover:text-black">
              <Icon name="arrowUpRight" className="h-5 w-5 -rotate-45 transition-transform duration-300 group-hover:rotate-0" />
            </span>
          </div>
        </div>
      </a>
    )}

    <div class="rounded-xl border border-white/10 bg-carbon-800/50 p-6 sm:p-8" data-reveal style="--reveal-delay:100ms">
      <h3 class="mb-6 font-display text-lg font-extrabold uppercase tracking-tight text-white">
        Baremario de servicios
      </h3>
      <div class="flex flex-col">
        {priceList.map((s) => {
          const msg = `Hola VARANO DETAIL! Quiero consultar por el servicio de ${s.title}.`;
          return (
            <a
              href={whatsapp.link + encodeURIComponent(msg)}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between border-b border-white/10 py-4 text-sm transition-colors hover:border-racing-orange/40"
            >
              <span class="font-semibold text-white/80 group-hover:text-white">
                {s.title}
              </span>
              <span class="font-display font-extrabold text-racing-orange">
                {s.price}
              </span>
            </a>
          );
        })}
      </div>
      <p class="mt-6 text-xs text-white/40">
        * Precios orientativos. Consultá por cada caso específico.
      </p>
    </div>
  </div>
</section>
