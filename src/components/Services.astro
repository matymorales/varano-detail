---
import Icon from "./ui/Icon.astro";
import { services, whatsapp } from "../data/site";
---

  <section class="section-glow relative py-24 sm:py-32">
  <div id="servicios" class="wrap">
    <div class="mb-14 flex flex-col gap-6 md:mb-16 md:flex-row md:items-end md:justify-between">
      <div data-reveal>
        <p class="eyebrow mb-5">Servicios</p>
        <h2 class="font-display font-black uppercase leading-[0.98] tracking-[-0.015em] text-white">
          <span class="block text-4xl sm:text-5xl md:text-6xl">Tratamiento</span>
          <span class="block text-outline text-4xl sm:text-5xl md:text-6xl">completo</span>
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-white/55" data-reveal style="--reveal-delay:100ms">
        Del lavado básico a la restauración profunda: cada servicio pensado para devolverle
        a tu vehículo esa terminación de estreno.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-4 md:auto-rows-[200px]">
      {services.map((s, i) => {
        const msg = `Hola VARANO DETAIL! Quiero consultar por el servicio de ${s.title}.`;
        return (
        <a
          href={whatsapp.link + encodeURIComponent(msg)}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Consultar por WhatsApp: ${s.title}`}
          class={`tile group min-h-[340px] sm:min-h-[380px] focus-visible:outline-none focus-visible:border-racing-orange reveal ${s.featured ? "md:col-span-2 md:row-span-2 md:min-h-[424px]" : "md:min-h-0"} ${s.className}`}
          data-reveal
          style={`--reveal-delay:${i * 70}ms`}
        >
          <img
            src={s.image}
            alt={s.title}
            class="tile-media opacity-70"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-carbon-950 via-carbon-950/40 to-transparent" />

          <div class="relative flex h-full flex-col justify-end p-6 sm:p-7">
            <p class="mb-4 text-[10px] font-bold uppercase tracking-[0.28em] text-racing-orange/90">
              Consultar
            </p>
            <div class="flex items-end justify-between gap-4">
              <div>
                <h3 class={`font-display font-extrabold uppercase leading-[1.02] tracking-tight text-white ${s.featured ? "text-2xl sm:text-3xl" : "text-xl"}`}>
                  {s.title}
                </h3>
                <p class={`mt-2.5 max-w-sm text-sm leading-relaxed text-white/60 ${s.featured ? "" : "line-clamp-3"}`}>
                  {s.desc}
                </p>
              </div>
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/20 text-white/70 transition-all duration-300 group-hover:border-racing-orange group-hover:bg-racing-orange group-hover:text-black">
                <Icon name="arrowUpRight" className="h-4 w-4 -rotate-45 transition-transform duration-300 group-hover:rotate-0" />
              </span>
            </div>
          </div>
        </a>
        );
      })}
    </div>
  </div>
</section>