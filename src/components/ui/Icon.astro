const { name, className = "h-5 w-5" } = Astro.props;

const filled = name === "whatsapp" || name === "phone";

const strokeAttrs = filled
  ? { fill: "currentColor" }
  : {
      fill: "none",
      stroke: "currentColor",
      "stroke-width": 1.8,
      "stroke-linecap": "round" as const,
      "stroke-linejoin": "round" as const,
